# Ambiente geral
ENVIRONMENT=production
PROJECT_NAME=Scores 2026
TZ=America/Bahia

# Publicação local dos containers para proxy reverso no host
# Mantém backend/frontend acessíveis somente no próprio servidor.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=18080
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=18000

# Banco e cache
POSTGRES_DB=scores2026
POSTGRES_USER=scores_user
POSTGRES_PASSWORD=troque_esta_senha
DATABASE_URL=postgresql+psycopg2://scores_user:troque_esta_senha@postgres:5432/scores2026
REDIS_URL=redis://redis:6379/0

# Segurança
SECRET_KEY=troque_por_uma_chave_grande_e_aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=https://scores.br10consultoria.com.br
# Use esta regex quando acessar por IP, porta alternativa ou outro subdomínio durante implantação.
# Exemplo: CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|.*\.br10consultoria\.com\.br|[0-9.]+)(:[0-9]+)?$
CORS_ORIGIN_REGEX=

# URL da API consumida pelo frontend no navegador
VITE_API_URL=https://scores.br10consultoria.com.br/api/v1

# Usuário administrador inicial
FIRST_SUPERUSER_EMAIL=admin@scores.local
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=Admin@123456

# SofaScore
# A coleta principal usa Série A e Série B. Ajuste aqui se a SofaScore alterar IDs de temporada.
SOFASCORE_BASE_URL=https://api.sofascore.com/api/v1
SOFASCORE_TOURNAMENT_ID=325
SOFASCORE_SEASON_ID=87678
SOFASCORE_SERIE_A_TOURNAMENT_ID=325
SOFASCORE_SERIE_A_SEASON_ID=87678
SOFASCORE_SERIE_B_TOURNAMENT_ID=390
SOFASCORE_SERIE_B_SEASON_ID=89840
SOFASCORE_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
SOFASCORE_REFERER=https://www.sofascore.com/
SOFASCORE_COOKIE=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# OpenAI / IA
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1400
